{
  "name": "threat-sense",
  "version": "0.0.1",
  "description": "Threat Sense protects users from clipboard-hijack scams and attacks",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --config tests/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config tests/playwright.config.ts --debug",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.60.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0"
  }
}